<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="com.hotel.front.RegisterController">

    <top>
        <Label text="Crear cuenta"
               style="-fx-padding: 10; -fx-font-size: 18; -fx-font-weight: bold;"/>
    </top>

    <center>
        <VBox alignment="CENTER" spacing="12">
            <padding>
                <Insets top="20" right="20" bottom="20" left="20"/>
            </padding>

            <TextField fx:id="nombreField"   promptText="Nombre"/>
            <TextField fx:id="apellidoField" promptText="Apellido"/>
            <TextField fx:id="emailField"    promptText="Email"/>
            <PasswordField fx:id="passwordField" promptText="Contraseña"/>

            <HBox spacing="10">
                <Button text="Crear cuenta" fx:id="crearCuentaButton"/>
                <Button text="Volver"       fx:id="volverButton"/>
            </HBox>
        </VBox>
    </center>

</BorderPane>
