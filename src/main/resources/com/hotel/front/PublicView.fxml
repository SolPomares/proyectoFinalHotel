<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.image.*?>
<?import java.net.*?>

<BorderPane xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="com.hotel.front.PublicController">
    <stylesheets>
        <URL value="@styles.css" />
    </stylesheets>

    <top>
        <Label text="Hotel Las Olas"
               style="-fx-padding: 10; -fx-font-size: 20; -fx-font-weight: bold;"/>
    </top>


    <center>
        <!-- Caja central con mensaje, sin imágenes -->
        <StackPane styleClass="hero" BorderPane.alignment="CENTER">
            <VBox alignment="CENTER" spacing="10">
                <Label text="Bienvenido al Hotel Las Olas" styleClass="hero-title"/>
                <Label text="Mañana agregamos secciones (Habitaciones, Promos, Contacto)."
                       styleClass="hero-sub"/>
            </VBox>
        </StackPane>
    </center>



</BorderPane>
