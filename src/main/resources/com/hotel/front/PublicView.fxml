<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.image.*?>
<?import javafx.geometry.Insets?>
<?import java.net.URL?>

<BorderPane xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="com.hotel.front.PublicController">

    <stylesheets>
        <URL value="@styles.css" />
    </stylesheets>

    <!-- CABECERA SIMPLE -->
    <top>
        <Label text="Hotel Las Olas"
               style="-fx-padding: 12; -fx-font-size: 22; -fx-font-weight: bold;"/>
    </top>

    <!-- CONTENIDO CENTRAL -->
    <center>
        <VBox alignment="CENTER" spacing="30" BorderPane.alignment="CENTER">

            <!-- HERO (Presentación principal) -->
            <StackPane styleClass="hero">
                <VBox alignment="CENTER" spacing="10">
                    <Label text="Bienvenido al Hotel Las Olas" styleClass="hero-title"/>
                    <Label text="Elegí tu próxima estadía entre nuestras mejores opciones."
                           styleClass="hero-sub"/>
                </VBox>
            </StackPane>

            <!-- BOTONES DE LOGIN / REGISTRO -->
            <HBox alignment="CENTER" spacing="15">
                <Button text="Hazte una cuenta"
                        onAction="#goToRegister"
                        styleClass="primary-btn"/>
                <Button text="Inicia sesión"
                        onAction="#goToLogin"
                        styleClass="primary-btn"/>
            </HBox>

            <!-- SECCIÓN DE TARJETAS -->
            <VBox spacing="10" alignment="CENTER">
                <Label text="¿Aún te interesan estos alojamientos?"
                       styleClass="section-title"/>

                <ScrollPane hbarPolicy="AS_NEEDED" vbarPolicy="NEVER"
                            fitToHeight="true"
                            prefViewportHeight="260"
                            prefViewportWidth="650">

                    <content>
                        <HBox spacing="20">
                            <padding>
                                <Insets top="10" right="10" bottom="10" left="10"/>
                            </padding>

                            <!-- TARJETA 1 -->
                            <VBox styleClass="hotel-card" spacing="8">
                                <ImageView fitWidth="220" fitHeight="130" preserveRatio="true">
                                    <image>
                                        <Image url="@/com/hotel/front/img/fondo1.jpg"/>
                                    </image>
                                </ImageView>
                                <Label text="Mini Complejo El Encuentro" styleClass="card-title"/>
                                <Label text="Sierra de los Padres, Argentina" styleClass="card-location"/>
                                <HBox spacing="6">
                                    <Label text="9.6" styleClass="card-score"/>
                                    <Label text="Excepcional · 22 comentarios" styleClass="card-review"/>
                                </HBox>
                            </VBox>

                            <!-- TARJETA 2 (pendiente si querés agregarla después) -->
                            <VBox styleClass="hotel-card" spacing="8">
                                <ImageView fitWidth="220" fitHeight="130" preserveRatio="true">
                                    <image>
                                        <Image url="@/com/hotel/front/img/fondo2.jpg"/>
                                    </image>
                                </ImageView>
                                <Label text="Sierra Suites" styleClass="card-title"/>
                                <Label text="Sierra de los Padres, Argentina" styleClass="card-location"/>
                                <HBox spacing="6">
                                    <Label text="7.6" styleClass="card-score"/>
                                    <Label text="Bien · 136 comentarios" styleClass="card-review"/>
                                </HBox>
                            </VBox>

                        </HBox>
                    </content>
                </ScrollPane>
            </VBox>

        </VBox>
    </center>

</BorderPane>
