<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="com.hotel.front.LoginController">

    <top>
        <Label text="Iniciar sesión"
               style="-fx-padding: 10; -fx-font-size: 18; -fx-font-weight: bold;"/>
    </top>

    <center>
        <VBox alignment="CENTER" spacing="12">
            <padding>
                <Insets top="20" right="20" bottom="20" left="20"/>
            </padding>

            <!-- Estos IDs deben coincidir con LoginController -->
            <TextField fx:id="txtUsuario" promptText="Usuario"/>
            <PasswordField fx:id="txtPassword" promptText="Contraseña"/>

            <HBox spacing="10" alignment="CENTER">
                <!-- Botón que llama al método loginUser() -->
                <Button text="Iniciar sesión" onAction="#loginUser"/>
                <!-- Botón que llama a volverAlInicio() -->
                <Button text="Volver" onAction="#volverAlInicio"/>
            </HBox>
        </VBox>
    </center>

</BorderPane>
